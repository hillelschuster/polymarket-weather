# Copy this file to .env and fill in YOUR values. Never share .env or paste the key in chat.
# The trader refuses to send real orders unless LIVE_ENABLED=true AND DRY_RUN=false AND the key is set.

LIVE_ENABLED=false
DRY_RUN=true
CHAIN_ID=137

# Polymarket account private key (Settings -> Export Private Key in the Polymarket UI).
# If your account was created with email login, also set FUNDER to your deposit address
# (the Polymarket proxy wallet that holds the USDC) so orders route through it.
PRIVATE_KEY=
FUNDER=

# === $250 Initial Bankroll Risk Calibration ===
CARD=25.0              # Max USD stake per locked dead-bucket position (10% of $250 bankroll)
MAX_OPEN=3             # Max concurrent open positions ($75 max capital at risk = 30% max)
MAX_TRADES_DAY=8       # Max trade executions per calendar day
MAX_COST_DAY=50.0      # Max total USD spend per day (20% daily risk cap)

# Lotto Sweep Rules (sub-0.2c tickets)
ALLOW_LOTTOS=true      # Set to true to enable R1/R4 lotto sweep execution
LOTTO_SWEEP_CAP=5.0    # Max USD spend per lotto sweep order ($5 buys 2,500-5,000 shares @ 0.1-0.2c)
LOTTO_DAY_CAP=10.0     # Max USD daily budget on lotto sweeps

# Execution Freshness Gate (Fail Loud / Stale Defense)
ALERT_MAX_AGE_SEC=600  # Max age (seconds) of detection alert at execution (default: 600s = 10min)
