[Unit]
Description=Polymarket Weather Automated Trading Bot (Supervisor + Trader)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Polymarket-weather
ExecStart=/root/Polymarket-weather/venv/bin/python -u /root/Polymarket-weather/scripts/watchdog.py
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=15
StandardOutput=append:/root/Polymarket-weather/data/run.log
StandardError=append:/root/Polymarket-weather/data/run.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
