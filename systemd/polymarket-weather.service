[Unit]
Description=Polymarket Weather Automated Trading Bot (Supervisor + Trader)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/polyweather-bot
ExecStart=/opt/polyweather-bot/venv/bin/python -u /opt/polyweather-bot/scripts/watchdog.py
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=15
StandardOutput=append:/opt/polyweather-bot/data/run.log
StandardError=append:/opt/polyweather-bot/data/run.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
